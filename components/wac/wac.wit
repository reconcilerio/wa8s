package root:component;

world root {
  import componentized:component/types@0.1.0;

  export componentized:component/wac-loader@0.1.0;
}
package componentized:component@0.1.0 {
  interface types {
    type wasm = list<u8>;

    record malformed {
      name: option<string>,
      message: string,
    }

    variant error-code {
      malformed(malformed),
      not-component(option<string>),
      not-found(option<string>),
      other(option<string>),
    }
  }
  interface wac-loader {
    use types.{wasm, error-code};

    type package-name = string;

    type dependency = tuple<package-name, wasm>;

    variant plan {
      wac(string),
    }

    plug: async func(socket: wasm, plugs: list<wasm>) -> result<wasm, error-code>;

    compose: async func(plan: plan, dependencies: list<dependency>) -> result<wasm, error-code>;
  }
}
